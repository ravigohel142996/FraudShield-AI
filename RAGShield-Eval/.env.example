# RAGShield Eval — environment template
#
# Copy to .env and fill in ONE provider key. .env is git-ignored and is excluded from the
# submission archive by scripts/build_submission_zip.py.
#
# Never commit a real key. Never paste a key into a run label, task file, report or issue.
# The runner reads these names from the environment; it never prints their values.

# --- OpenAI (used by provider: openai) ---
OPENAI_API_KEY=

# --- Anthropic (used by provider: anthropic) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (used by provider: gemini) ---
GEMINI_API_KEY=

# --- Groq (used by provider: groq) ---
GROQ_API_KEY=

# Notes
# -----
# 1. Presence of a key is NOT permission to spend. Live calls also require, in
#    config/benchmark.yaml:
#        budget.allow_live_calls: true
#        budget.max_total_cost_usd: <your approved limit>
# 2. `python -m src.runner preflight` prints the worst-case estimate for the configured
#    models and refuses to run if it exceeds that limit.
# 3. `python -m src.runner credentials` reports which of the above are set (names only).
